<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Atomic.App.Controls.AiChatPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Atomic.App.Controls"
    xmlns:services="using:Atomic.App.Services"
    mc:Ignorable="d"
    Visibility="Collapsed"
    IsTabStop="False">

    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <!--
                The fade's transparent end. A gradient from Transparent would pass through a dark
                grey on the way to a light colour, because the stops are not interpolated as
                premultiplied. The transparent end has to be the solid end's own colour at zero
                alpha, and a theme resource cannot carry an alpha of its own - hence one per theme,
                matching SolidBackgroundFillColorBase (#F3F3F3 light, #202020 dark).
            -->
            <ResourceDictionary x:Key="Light">
                <Color x:Key="ChipFadeClear">#00F3F3F3</Color>
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <Color x:Key="ChipFadeClear">#00202020</Color>
            </ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast">
                <Color x:Key="ChipFadeClear">#00000000</Color>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>

        <!--
            Bubbles.

            Each is a Border + a TextBlock carrying controls:MarkdownText.Source. Text stays in a
            plain TextBlock so wrapping, selection and theme brushes all come for free; the attached
            property only fills its Inlines.
        -->
        <DataTemplate x:Key="UserTemplate" x:DataType="services:ChatMessage">
            <Grid Margin="32,4,0,4" HorizontalAlignment="Right">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="12,12,4,12"
                        Padding="12,8">
                    <TextBlock Text="{x:Bind Text}"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                               IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssistantTemplate" x:DataType="services:ChatMessage">
            <Grid Margin="0,4,32,4" HorizontalAlignment="Left">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12,12,12,4"
                        Padding="12,8">
                    <StackPanel Spacing="8">
                        <TextBlock controls:MarkdownText.Source="{x:Bind Text}"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" />

                        <!--
                            The card slot: the chart the answer names.

                            ChatCardView switches on the kind and falls back to a named strip when
                            the visual cannot be built. The content is bound whether or not it is
                            locked - see ProGate - which is what makes unlocking a single property
                            change with no re-bind.
                        -->
                        <controls:ProGate x:Name="CardGate"
                                          Visibility="{x:Bind HasCard}"
                                          IsLocked="{x:Bind IsCardLocked}"
                                          HorizontalContentAlignment="Stretch">
                            <controls:ChatCardView Card="{x:Bind Cards}" />
                        </controls:ProGate>

                        <!-- The upsell, over the gated card rather than instead of it. -->
                        <TextBlock Text="{x:Bind CardLockedLabel}"
                                   Visibility="{x:Bind IsCardLockedVisibility}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <!--
                            Citation chips. The renderer supports no links at all, so a citation
                            cannot be a hyperlink inside the text - carrying it as data and
                            rendering it here is what makes a grounded answer navigable.
                        -->
                        <!-- No Visibility binding needed: an empty ItemsControl has no height. -->
                        <ItemsControl ItemsSource="{x:Bind DecodedActions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}"
                                            Tag="{Binding}"
                                            Click="Action_Click"
                                            Padding="10,4"
                                            FontSize="12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!--
            The thinking bubble. The engine is synchronous and sub-50 ms once warm, so this is
            cosmetic for every question after the first - but the first one builds the BM25 index,
            and that is long enough to need saying something.
        -->
        <DataTemplate x:Key="ThinkingTemplate" x:DataType="services:ChatMessage">
            <Border Margin="0,4,32,4"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12,12,12,4"
                    Padding="14,10">
                <controls:ThinkingDots />
            </Border>
        </DataTemplate>

        <controls:ChatTemplateSelector x:Key="MessageTemplates"
                                       User="{StaticResource UserTemplate}"
                                       Assistant="{StaticResource AssistantTemplate}"
                                       Thinking="{StaticResource ThinkingTemplate}" />

        <!-- Zeroes the container chrome so a bubble is not boxed inside a list row. -->
        <Style x:Key="BubbleContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!--
            The drawer. A Border on the right edge of the window's second column, full height below
            the title bar, slid in by a composition translation - see the code-behind for why not a
            Storyboard.

            Background is transparent, which is the point: it shows the window's Mica, the same
            surface as the navigation pane on the other side. That only works because the drawer is
            docked beside the page. Laid over it, a transparent drawer would show the page's text
            through the answer, and an opaque one is not Mica.
        -->
        <Border x:Name="Sheet"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="Transparent"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                SizeChanged="Sheet_SizeChanged">
            <Grid x:Name="SheetLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Padding="16,12,12,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock x:Name="BetaBadge"
                                       FontSize="10"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>

                        <!--
                            The day's remaining messages, as Android shows them. PRO+ reads
                            "Unlimited" rather than the badge vanishing, which said nothing about
                            why it had gone. ToolTip carries the reset time so the number does not
                            have to explain itself.
                        -->
                        <TextBlock x:Name="LimitBadge"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <Button x:Name="NewChatButton" Grid.Column="1"
                            Click="NewChat_Click"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                    </Button>

                    <Button x:Name="CloseButton" Grid.Column="2"
                            Click="Close_Click"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE711;" FontSize="16" />
                    </Button>
                </Grid>

                <!-- Thread -->
                <ListView x:Name="MessageList"
                          Grid.Row="1"
                          ItemsSource="{x:Bind Session.Messages, Mode=OneWay}"
                          ItemTemplateSelector="{StaticResource MessageTemplates}"
                          ItemContainerStyle="{StaticResource BubbleContainerStyle}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          Padding="16,0,16,8"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" />

                <!-- Empty state, shown in place of the thread before the first question. -->
                <TextBlock x:Name="EmptyState"
                           Grid.Row="1"
                           Margin="24"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!--
                    Example questions: before the first question, the starters; afterwards, the
                    follow-ups to the latest answer.

                    A horizontal strip of small single-line chips. Each is a whole question, so one
                    that does not fit is trimmed with an ellipsis and carries the full text in its
                    tooltip; clicking sends the whole thing either way.

                    The 16px gutter is padding on the items, not margin on the scroller: the first
                    chip starts level with the input below it, and the last one scrolls out under the
                    edge instead of stopping short of it. 16 is the thread's and the composer's
                    gutter, so the three line up.
                -->
                <Grid x:Name="SuggestionStrip" Grid.Row="2">
                <ScrollViewer x:Name="SuggestionScroller"
                              ViewChanged="Suggestions_ViewChanged"
                              SizeChanged="Suggestions_SizeChanged"
                              HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled"
                              PointerWheelChanged="Suggestions_PointerWheelChanged">
                    <ItemsControl x:Name="SuggestionList"
                                  SizeChanged="Suggestions_SizeChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" Padding="16,6,16,10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}"
                                        Click="Suggestion_Click"
                                        MinHeight="0"
                                        MaxWidth="220"
                                        Padding="10,4"
                                        ToolTipService.ToolTip="{Binding}">
                                    <TextBlock Text="{Binding}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--
                    The fade at the right edge, shown only while there is more to scroll to - on a
                    strip that fits, it would grey out the last chip for nothing. It does not take
                    input, so the chips under it stay clickable.

                    A gradient to the theme's base colour, not a true alpha mask: Mica is tinted by
                    the wallpaper and no fixed colour matches it exactly, so on some wallpapers the
                    last 40px is very slightly off the surface around it.
                -->
                <Rectangle x:Name="SuggestionFade"
                           Width="40"
                           HorizontalAlignment="Right"
                           IsHitTestVisible="False"
                           Visibility="Collapsed">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{ThemeResource ChipFadeClear}" Offset="0" />
                            <GradientStop Color="{ThemeResource SolidBackgroundFillColorBase}" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                </Grid>

                <!-- Composer -->
                <Grid Grid.Row="3" Padding="16,4,16,16" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="Input"
                             KeyDown="Input_KeyDown"
                             TextChanged="Input_TextChanged"
                             AcceptsReturn="False"
                             TextWrapping="NoWrap" />

                    <Button x:Name="SendButton" Grid.Column="1"
                            Click="Send_Click"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}">
                        <FontIcon Glyph="&#xE724;" FontSize="16" />
                    </Button>
                </Grid>

                <!--
                    Resize handle on the left edge. Windows users expect a resizable surface, and a
                    drawer that cannot widen is the wrong shape for an answer with a working section.
                    Eight pixels wide, over the content's 16px gutter rather than beside it.
                -->
                <Border x:Name="Grip"
                        Grid.RowSpan="4"
                        Width="8"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        ManipulationMode="TranslateX"
                        ManipulationDelta="Grip_ManipulationDelta"
                        PointerEntered="Grip_PointerEntered"
                        PointerExited="Grip_PointerExited">
                    <Rectangle Width="3" Height="36"
                               RadiusX="1.5" RadiusY="1.5"
                               VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
