<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Atomic.App.Controls.AiChatPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Atomic.App.Controls"
    xmlns:services="using:Atomic.App.Services"
    mc:Ignorable="d"
    Visibility="Collapsed"
    IsTabStop="False">

    <UserControl.Resources>

        <!--
            Only what the user types is a bubble. The assistant's answers are plain text across the
            width of the thread, as Copilot's are: an answer is a document - headings, lists, a
            sources section, a chart - and a card around it makes a long one look like a very large
            chat message. The bubble is what tells the two voices apart, so only one of them has it.

            Text stays in a plain TextBlock carrying controls:MarkdownText.Source, so wrapping,
            selection and theme brushes all come for free; the attached property only fills its
            Inlines.
        -->
        <DataTemplate x:Key="UserTemplate" x:DataType="services:ChatMessage">
            <Grid Margin="32,4,0,4" HorizontalAlignment="Right">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="12,12,4,12"
                        Padding="12,8">
                    <TextBlock Text="{x:Bind Text}"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                               IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssistantTemplate" x:DataType="services:ChatMessage">
            <Grid Margin="0,8,0,8" HorizontalAlignment="Stretch">
                <Border Padding="0,4">
                    <StackPanel Spacing="8">
                        <TextBlock controls:MarkdownText.Source="{x:Bind Text}"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" />

                        <!--
                            The card slot: the chart the answer names.

                            ChatCardView switches on the kind and falls back to a named strip when
                            the visual cannot be built. The content is bound whether or not it is
                            locked - see ProGate - which is what makes unlocking a single property
                            change with no re-bind.
                        -->
                        <controls:ProGate x:Name="CardGate"
                                          Visibility="{x:Bind HasCard}"
                                          IsLocked="{x:Bind IsCardLocked}"
                                          HorizontalContentAlignment="Stretch">
                            <controls:ChatCardView Card="{x:Bind Cards}" />
                        </controls:ProGate>

                        <!-- The upsell, over the gated card rather than instead of it. -->
                        <TextBlock Text="{x:Bind CardLockedLabel}"
                                   Visibility="{x:Bind IsCardLockedVisibility}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <!--
                            Citation chips. The renderer supports no links at all, so a citation
                            cannot be a hyperlink inside the text - carrying it as data and
                            rendering it here is what makes a grounded answer navigable.
                        -->
                        <!-- No Visibility binding needed: an empty ItemsControl has no height. -->
                        <ItemsControl ItemsSource="{x:Bind DecodedActions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}"
                                            Tag="{Binding}"
                                            Click="Action_Click"
                                            Padding="10,4"
                                            FontSize="12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!--
            The thinking bubble. The engine is synchronous and sub-50 ms once warm, so this is
            cosmetic for every question after the first - but the first one builds the BM25 index,
            and that is long enough to need saying something.
        -->
        <DataTemplate x:Key="ThinkingTemplate" x:DataType="services:ChatMessage">
            <Border Margin="0,8,0,8"
                    HorizontalAlignment="Left"
                    Padding="0,6">
                <controls:ThinkingDots />
            </Border>
        </DataTemplate>

        <controls:ChatTemplateSelector x:Key="MessageTemplates"
                                       User="{StaticResource UserTemplate}"
                                       Assistant="{StaticResource AssistantTemplate}"
                                       Thinking="{StaticResource ThinkingTemplate}" />

        <!-- Zeroes the container chrome so a bubble is not boxed inside a list row. -->
        <Style x:Key="BubbleContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!--
            The drawer. A Border on the right edge, full height below the title bar, slid in by a
            composition translation - see the code-behind for why not a Storyboard.

            Itself transparent: the surface is one of two layers beneath the content, and
            AiChatPanel.ApplyMode shows one. Docked, in a column of its own, it is the same
            surface as the page beside it. Floating over the page, in a window too small to share,
            it is acrylic, which blurs the page behind it. The divider is on the layers, not here,
            so it follows whichever is showing.
        -->
        <Border x:Name="Sheet"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="Transparent"
                SizeChanged="Sheet_SizeChanged">
            <Grid x:Name="SheetLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    Docked: the page's own surface. These are the NavigationView's content-area
                    resources - the layer fill, the card stroke as a divider on the top and left, the
                    8px corner at the top-left - so it matches the page beside it exactly, in either
                    theme, without restating a colour. Over the window's Mica the layer fill is the
                    off-white of the periodic table's card.
                -->
                <Border x:Name="DockedLayer"
                        Grid.RowSpan="4"
                        IsHitTestVisible="False"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,1,0,0"
                        CornerRadius="8,0,0,0" />

                <!-- Floating over the page: acrylic, the same divider and corner. -->
                <Border x:Name="AcrylicLayer"
                        Grid.RowSpan="4"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,1,0,0"
                        CornerRadius="8,0,0,0" />

                <!-- Header -->
                <Grid Grid.Row="0" Padding="16,12,12,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                        The history, where Edge puts its sidebar button: first in the header. The
                        negative margin lines the icon up with the 16px gutter the thread and the
                        input use, rather than with the button's own padding.
                    -->
                    <Button x:Name="HistoryButton" Grid.Column="0"
                            Click="History_Click"
                            Margin="-8,0,0,0"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE81C;" FontSize="16" />
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock x:Name="BetaBadge"
                                       FontSize="10"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>

                        <!--
                            The day's remaining messages, as Android shows them. PRO+ reads
                            "Unlimited" rather than the badge vanishing, which said nothing about
                            why it had gone. ToolTip carries the reset time so the number does not
                            have to explain itself.
                        -->
                        <TextBlock x:Name="LimitBadge"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <Button x:Name="NewChatButton" Grid.Column="2"
                            Click="NewChat_Click"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                    </Button>

                    <Button x:Name="CloseButton" Grid.Column="3"
                            Click="Close_Click"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE711;" FontSize="16" />
                    </Button>
                </Grid>

                <!-- Thread -->
                <ListView x:Name="MessageList"
                          Grid.Row="1"
                          ItemsSource="{x:Bind Session.Messages, Mode=OneWay}"
                          ItemTemplateSelector="{StaticResource MessageTemplates}"
                          ItemContainerStyle="{StaticResource BubbleContainerStyle}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          Padding="16,0,16,8"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <!--
                        Each new message rises in from just below and fades in. Not staggered, so a
                        reopened conversation arrives as one piece rather than as a cascade. A
                        reposition transition lets the rest of the thread slide rather than jump when
                        something is added above the end.
                    -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="False" />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                </ListView>

                <!-- Empty state, shown in place of the thread before the first question. -->
                <TextBlock x:Name="EmptyState"
                           Grid.Row="1"
                           Margin="24"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!--
                    Example questions: before the first question, the starters; afterwards, the
                    follow-ups to the latest answer.

                    A horizontal strip of small single-line chips. Each is a whole question, so one
                    that does not fit is trimmed with an ellipsis and carries the full text in its
                    tooltip; clicking sends the whole thing either way.

                    The 16px gutter is padding on the items, not margin on the scroller: the first
                    chip starts level with the input below it, and the last one scrolls out under the
                    edge instead of stopping short of it. 16 is the thread's and the composer's
                    gutter, so the three line up.

                    The right edge fades by lowering the opacity of the chips that reach it, in the
                    code-behind. A gradient laid over the strip would have to be the colour of what
                    is behind, and behind is a blur of the page.
                -->
                <Grid x:Name="SuggestionStrip" Grid.Row="2">
                <ScrollViewer x:Name="SuggestionScroller"
                              ViewChanged="Suggestions_ViewChanged"
                              SizeChanged="Suggestions_SizeChanged"
                              HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled"
                              PointerWheelChanged="Suggestions_PointerWheelChanged">
                    <ItemsControl x:Name="SuggestionList"
                                  SizeChanged="Suggestions_SizeChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" Padding="16,6,16,10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}"
                                        Click="Suggestion_Click"
                                        MinHeight="0"
                                        MaxWidth="220"
                                        Padding="10,4"
                                        ToolTipService.ToolTip="{Binding}">
                                    <TextBlock Text="{Binding}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>

                <!-- Composer -->
                <Grid Grid.Row="3" Padding="16,4,16,16" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="Input"
                             KeyDown="Input_KeyDown"
                             TextChanged="Input_TextChanged"
                             AcceptsReturn="False"
                             TextWrapping="NoWrap" />

                    <Button x:Name="SendButton" Grid.Column="1"
                            Click="Send_Click"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}">
                        <FontIcon Glyph="&#xE724;" FontSize="16" />
                    </Button>
                </Grid>


                <!--
                    Chat history, as a sidebar from the left over the conversation - below the
                    header, so the button that opened it is still there to close it. A panel this
                    narrow has no room to put the list beside the conversation, so it covers it,
                    with a light scrim over the rest that closes it when tapped.

                    In-app acrylic: it blurs the conversation behind it, so the list reads as a
                    layer over the chat rather than as a page replacing it.
                -->
                <Grid x:Name="HistoryPane"
                      Grid.Row="1"
                      Grid.RowSpan="3"
                      Visibility="Collapsed">
                    <Rectangle Fill="{ThemeResource SmokeFillColorDefaultBrush}"
                               Tapped="HistoryScrim_Tapped" />

                    <Border x:Name="HistorySidebar"
                            Width="280"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,1,0"
                            CornerRadius="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="HistoryTitle"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Margin="16,14,16,8" />

                            <!-- While the phone's conversations are being fetched. -->
                            <ProgressBar x:Name="HistorySyncing"
                                         Grid.Row="1"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed"
                                         Margin="16,0,16,4" />

                            <ListView x:Name="HistoryList"
                                      Grid.Row="2"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="HistoryList_ItemClick"
                                      Padding="4,0,4,8">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="services:StoredChatSession">
                                        <StackPanel Padding="8,6" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1" />
                                            <TextBlock Text="{x:Bind WhenDisplay}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Nothing saved yet, or why the list is not shown at all. -->
                            <TextBlock x:Name="HistoryMessage"
                                       Grid.Row="2"
                                       Margin="16,4,16,8"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!--
            Resize handle, in the gap between the page and the panel.

            Not a child of the sheet: it belongs to neither card, and its centre is the centre of
            the gap, which is outside the sheet. It is placed in the code-behind (PositionGrip) from
            the sheet's width, so it follows the panel as it is dragged.

            Ten pixels wide - the gap plus two either side - with the resize cursor on hover. It is
            not drawn: a permanent handle read as a control on a surface that is otherwise quiet. A
            short line appears under the pointer so the edge can be found, and is gone again when
            it leaves.
        -->
        <Border x:Name="Grip"
                Width="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="Transparent"
                PointerEntered="Grip_PointerEntered"
                PointerExited="Grip_PointerExited"
                PointerPressed="Grip_PointerPressed"
                PointerMoved="Grip_PointerMoved"
                PointerReleased="Grip_PointerReleased"
                PointerCaptureLost="Grip_PointerCaptureLost">
            <Rectangle x:Name="GripLine"
                       Width="2" Height="40"
                       RadiusX="1" RadiusY="1"
                       Opacity="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
        </Border>
    </Grid>
</UserControl>
