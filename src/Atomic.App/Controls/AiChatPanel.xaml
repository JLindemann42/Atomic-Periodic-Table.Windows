<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Atomic.App.Controls.AiChatPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Atomic.App.Controls"
    xmlns:services="using:Atomic.App.Services"
    mc:Ignorable="d"
    Visibility="Collapsed"
    IsTabStop="False">

    <UserControl.Resources>

        <!--
            Bubbles.

            Each is a Border + a TextBlock carrying controls:MarkdownText.Source. Text stays in a
            plain TextBlock so wrapping, selection and theme brushes all come for free; the attached
            property only fills its Inlines.
        -->
        <DataTemplate x:Key="UserTemplate" x:DataType="services:ChatMessage">
            <Grid Margin="32,4,0,4" HorizontalAlignment="Right">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="12,12,4,12"
                        Padding="12,8">
                    <TextBlock Text="{x:Bind Text}"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                               IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssistantTemplate" x:DataType="services:ChatMessage">
            <Grid Margin="0,4,32,4" HorizontalAlignment="Left">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12,12,12,4"
                        Padding="12,8">
                    <StackPanel Spacing="8">
                        <TextBlock controls:MarkdownText.Source="{x:Bind Text}"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" />

                        <!--
                            The card slot: the chart the answer names.

                            ChatCardView switches on the kind and falls back to a named strip when
                            the visual cannot be built. The content is bound whether or not it is
                            locked - see ProGate - which is what makes unlocking a single property
                            change with no re-bind.
                        -->
                        <controls:ProGate x:Name="CardGate"
                                          Visibility="{x:Bind HasCard}"
                                          IsLocked="{x:Bind IsCardLocked}"
                                          HorizontalContentAlignment="Stretch">
                            <controls:ChatCardView Card="{x:Bind Cards}" />
                        </controls:ProGate>

                        <!-- The upsell, over the gated card rather than instead of it. -->
                        <TextBlock Text="{x:Bind CardLockedLabel}"
                                   Visibility="{x:Bind IsCardLockedVisibility}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <!--
                            Citation chips. The renderer supports no links at all, so a citation
                            cannot be a hyperlink inside the text - carrying it as data and
                            rendering it here is what makes a grounded answer navigable.
                        -->
                        <!-- No Visibility binding needed: an empty ItemsControl has no height. -->
                        <ItemsControl ItemsSource="{x:Bind DecodedActions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}"
                                            Tag="{Binding}"
                                            Click="Action_Click"
                                            Padding="10,4"
                                            FontSize="12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!--
            The thinking bubble. The engine is synchronous and sub-50 ms once warm, so this is
            cosmetic for every question after the first - but the first one builds the BM25 index,
            and that is long enough to need saying something.
        -->
        <DataTemplate x:Key="ThinkingTemplate" x:DataType="services:ChatMessage">
            <Border Margin="0,4,32,4"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12,12,12,4"
                    Padding="14,10">
                <controls:ThinkingDots />
            </Border>
        </DataTemplate>

        <controls:ChatTemplateSelector x:Key="MessageTemplates"
                                       User="{StaticResource UserTemplate}"
                                       Assistant="{StaticResource AssistantTemplate}"
                                       Thinking="{StaticResource ThinkingTemplate}" />

        <!-- Zeroes the container chrome so a bubble is not boxed inside a list row. -->
        <Style x:Key="BubbleContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!--
            Scrim. Tapping it dismisses, matching every other modal surface in the app; its opacity
            is animated rather than its Visibility so the sheet does not appear to snap.
        -->
        <Rectangle x:Name="Scrim"
                   Fill="{ThemeResource SmokeFillColorDefaultBrush}"
                   Opacity="0"
                   Tapped="Scrim_Tapped" />

        <!--
            The drawer. A Border pinned to the right edge, full height below the 32px title bar,
            and slid in by a composition translation - see the code-behind for why not a
            Storyboard. The top margin is the title bar's height: the window extends its content
            into the title bar, so without it the header buttons sit under the system caption
            buttons.

            Background is opaque, not LayerFillColorDefaultBrush. That brush is semi-transparent by
            design, and over a Mica window the page behind shows straight through the answer text -
            unreadable, and worse the longer the answer is.
        -->
        <Border x:Name="Sheet"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Margin="0,32,0,0"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0"
                SizeChanged="Sheet_SizeChanged">
            <Grid x:Name="SheetLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Padding="16,12,12,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock x:Name="BetaBadge"
                                       FontSize="10"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>

                        <!--
                            The day's remaining messages, as Android shows them. PRO+ reads
                            "Unlimited" rather than the badge vanishing, which said nothing about
                            why it had gone. ToolTip carries the reset time so the number does not
                            have to explain itself.
                        -->
                        <TextBlock x:Name="LimitBadge"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <Button x:Name="NewChatButton" Grid.Column="1"
                            Click="NewChat_Click"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                    </Button>

                    <Button x:Name="CloseButton" Grid.Column="2"
                            Click="Close_Click"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE711;" FontSize="16" />
                    </Button>
                </Grid>

                <!-- Thread -->
                <ListView x:Name="MessageList"
                          Grid.Row="1"
                          ItemsSource="{x:Bind Session.Messages, Mode=OneWay}"
                          ItemTemplateSelector="{StaticResource MessageTemplates}"
                          ItemContainerStyle="{StaticResource BubbleContainerStyle}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          Padding="16,0,16,8"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" />

                <!-- Empty state, shown in place of the thread before the first question. -->
                <TextBlock x:Name="EmptyState"
                           Grid.Row="1"
                           Margin="24"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!--
                    Suggestion chips for the most recent answer only.

                    Stacked and full width rather than wrapped. Each one is a whole question - "How
                    much of 100 g of carbon-14 is left after 11460 years?" - and in a drawer this
                    narrow a wrap panel gave a long one its natural width, which ran off the edge.
                    The text wraps inside the button, left-aligned, so a two-line question reads as
                    one block instead of a centred ragged one.
                -->
                <ItemsControl x:Name="SuggestionList"
                              Grid.Row="2"
                              Padding="16,8,16,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding}"
                                    Click="Suggestion_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,8">
                                <TextBlock Text="{Binding}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Composer -->
                <Grid Grid.Row="3" Padding="16,4,16,16" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="Input"
                             KeyDown="Input_KeyDown"
                             TextChanged="Input_TextChanged"
                             AcceptsReturn="False"
                             TextWrapping="NoWrap" />

                    <Button x:Name="SendButton" Grid.Column="1"
                            Click="Send_Click"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}">
                        <FontIcon Glyph="&#xE724;" FontSize="16" />
                    </Button>
                </Grid>

                <!--
                    Resize handle on the left edge. Windows users expect a resizable surface, and a
                    drawer that cannot widen is the wrong shape for an answer with a working section.
                    Eight pixels wide, over the content's 16px gutter rather than beside it.
                -->
                <Border x:Name="Grip"
                        Grid.RowSpan="4"
                        Width="8"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        ManipulationMode="TranslateX"
                        ManipulationDelta="Grip_ManipulationDelta"
                        PointerEntered="Grip_PointerEntered"
                        PointerExited="Grip_PointerExited">
                    <Rectangle Width="3" Height="36"
                               RadiusX="1.5" RadiusY="1.5"
                               VerticalAlignment="Center"
                               Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
