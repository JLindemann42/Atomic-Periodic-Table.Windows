  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)'=='deb'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!--
      Trimming is OFF, and must stay off until the XAML stops using classic {Binding}.

      With PublishTrimmed=true a published build renders a periodic table of 118 completely
      blank tiles. The table binds DataContext="{Binding Element1}" on each button and then
      {Binding Symbol} / {Binding AtomicNumber} / {Binding Name} inside the control template.
      Classic {Binding} resolves by reflection at runtime, the trimmer cannot see those
      property accesses, and it strips them - so every binding silently yields nothing. The
      same applies to the other pages that use {Binding} rather than {x:Bind}.

      Verified by publishing the identical Release build twice, once each way: trimmed gives
      blank tiles, untrimmed renders correctly. Debug never reproduces it, because
      PublishTrimmed only applies to `dotnet publish`.

      Re-enabling this means converting the bindings to {x:Bind}, which is compile-time and
      trim-safe. Until then it costs package size and nothing else.
    -->
    <PublishTrimmed>False</PublishTrimmed>
