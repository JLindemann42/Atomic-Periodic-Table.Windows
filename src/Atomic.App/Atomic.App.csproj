	<ItemGroup>
		<!--
			The merged element tables, one per language, from the shared-data submodule (shared/,
			roadmap 0.3) that the Android app reads too. Linked into Assets\Elements so the runtime
			path is unchanged. Content rather than None so they are included in the MSIX payload as
			well as the build output.
		-->
		<Content Include="..\..\shared\elements\elements_*.json" Link="Assets\Elements\%(Filename)%(Extension)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<!-- The reference tables' titles in each language (roadmap 1.3). -->
		<Content Include="..\..\shared\datasets\titles_*.tsv" Link="Assets\Datasets\%(Filename)%(Extension)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<!-- The written explanations for why-questions, and their words in each language (roadmap 2.4). -->
		<Content Include="..\..\shared\datasets\explanations*.tsv" Link="Assets\Datasets\%(Filename)%(Extension)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<!-- The language detector's trigram model (roadmap 1.4). -->
		<Content Include="..\..\shared\language\trigrams.tsv" Link="Assets\Language\trigrams.tsv">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>


