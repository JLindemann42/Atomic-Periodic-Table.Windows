<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Atomic.App.ProPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Atomic.App.Localization"
    xmlns:local="using:Atomic.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <Storyboard x:Name="ProGradientStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="GradientStart"
                         Storyboard.TargetProperty="Offset"
                         From="0.0" To="0.3"
                         Duration="0:0:5" />
            <DoubleAnimation Storyboard.TargetName="GradientEnd"
                         Storyboard.TargetProperty="Offset"
                         From="0.3" To="0.7"
                         Duration="0:0:5" />
        </Storyboard>
    </Page.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="56,12,56,0">

            <Grid MinWidth="600" MaxWidth="1748" Margin="0,12">  
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Free Version -->
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Border x:Name="FreeCard"
                CornerRadius="20"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Translation="0,0,24">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>

                        <StackPanel>
                            <TextBlock Text="{loc:Str Key=pro_card_free_title}" FontSize="20" FontWeight="Bold" Margin="0,12,0,10"/>
                            <TextBlock Text="{loc:Str Key=pro_card_free_tagline}" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock x:Name="FreePrice" Text="{loc:Str Key=ai_free_user}" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Button x:Name="FreeButton" Content="{loc:Str Key=current_version}" Style="{StaticResource AccentButtonStyle}" Margin="0,15,0,10" HorizontalAlignment="Stretch" IsEnabled="False"/>
                            <TextBlock ><Run Text="• "/><Run Text="{loc:Str Key=feature_element_overview}"/></TextBlock>
                            <TextBlock ><Run Text="• "/><Run Text="{loc:Str Key=iso}"/></TextBlock>
                            <TextBlock ><Run Text="• "/><Run Text="{loc:Str Key=Dictionary}"/></TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Pro Version with gradient and working shadow -->
                <Grid Grid.Column="1" Margin="10,0,10,0">
                    <Grid x:Name="ProCardShadowHost" Translation="0,0,42" CornerRadius="20">
                        <!-- Apply shadow here -->
                        <Grid.Shadow>
                            <ThemeShadow />
                        </Grid.Shadow>

                        <!-- Gradient border with inner card -->
                        <Border CornerRadius="20" Padding="2">
                            <Border.Background>
                                <LinearGradientBrush x:Name="ProGradient" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="GradientStart" Color="#FF6EE7B7" Offset="0.0" />
                                    <GradientStop x:Name="GradientEnd" Color="#FF3B82F6" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>

                            <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    CornerRadius="18"
                    Padding="20">
                                <StackPanel>
                                    <TextBlock x:Name="Pro" Text="{loc:Str Key=pro_title}" FontSize="20" FontWeight="Bold" Margin="0,12,0,10"/>
                                    <TextBlock Text="{loc:Str Key=pro_card_pro_tagline}" FontSize="14" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="ProPrice" Text="---" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Button x:Name="BuyProButton" Content="{loc:Str Key=label_purchase}" Margin="0,15,0,10" Style="{StaticResource AccentButtonStyle}" Click="BuyProVersion_Click" HorizontalAlignment="Stretch"/>
                                    <TextBlock ><Run Text="• "/><Run Text="{loc:Str Key=pro_all_free_features}"/></TextBlock>
                                    <TextBlock ><Run Text="• "/><Run Text="{loc:Str Key=pro_additional_tables}"/></TextBlock>
                                    <TextBlock ><Run Text="• "/><Run Text="{loc:Str Key=pro_additional_features}"/></TextBlock>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- Most Popular badge -->
                        <Border Background="{ThemeResource SystemAccentColor}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="12"
                Padding="8,4"
                CornerRadius="10">
                            <TextBlock Text="{loc:Str Key=pro_most_popular}"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="Bold"
                       TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>


                <!-- Pro+ Version -->
                <Grid Grid.Column="2" Margin="10,0,0,0">
                    <Grid>
                        <!-- Card -->
                        <Border x:Name="ProPlusCard"
                    CornerRadius="20"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Translation="0,0,24">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>

                            <StackPanel>
                                <TextBlock x:Name="ProPlus" Text="{loc:Str Key=pro_plus_version}" FontSize="20" FontWeight="Bold" Margin="0,12,0,10"/>
                                <TextBlock Text="{loc:Str Key=pro_card_proplus_tagline}" FontSize="14" Margin="0,0,0,10"/>
                                <TextBlock x:Name="ProPlusPrice" Text="---" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>
                                <Button x:Name="BuyProPlusButton" Content="{loc:Str Key=label_purchase}" Margin="0,15,0,10" Style="{StaticResource AccentButtonStyle}" Click="BuyProPlusVersion_Click" HorizontalAlignment="Stretch"/>
                                <TextBlock ><Run Text="• "/><Run Text="{loc:Str Key=pro_all_pro_features}"/></TextBlock>
                                <TextBlock ><Run Text="• "/><Run Text="{loc:Str Key=pro_flashcards_and_lives}"/></TextBlock>
                                <TextBlock ><Run Text="• "/><Run Text="{loc:Str Key=feature_early_access}"/></TextBlock>
   
                            </StackPanel>
                        </Border>

                        <!-- Most Advanced badge -->
                        <Border Background="{ThemeResource SystemAccentColorDark2}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="12,12,24,0"
                    Padding="8,4"
                    CornerRadius="10">
                            <TextBlock Text="{loc:Str Key=most_advanced}"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="Bold"
                           TextAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>

            </Grid>

            <!--
                Ultimate. Full width and below the three tiers because it is not a fourth column in
                the same ladder - it is PRO+ bought once for every platform, and putting it beside
                them would invite reading it as "more PRO+".

                Collapsed until the Store catalogue actually returns the product, so an unreleased
                add-on shows nothing rather than a card that cannot be bought.
            -->
            <!--
                Always visible, including before the add-on exists in the Store. A tier the user
                cannot see is a tier they cannot plan to buy, so it announces itself and says
                "coming soon" rather than hiding until the listing is live.
            -->
            <Grid x:Name="UltimateSection"
                  MinWidth="600" MaxWidth="1748" Margin="0,10,0,20">
                <Border x:Name="UltimateCard"
                        CornerRadius="20"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="2"
                        Padding="32"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Translation="0,0,32">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,32,0">
                            <TextBlock x:Name="Ultimate" FontSize="30" FontWeight="Bold" Margin="0,4,0,12"/>
                            <TextBlock x:Name="UltimateDescription" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <TextBlock x:Name="UltimateBullets" FontSize="15" TextWrapping="Wrap"
                                       LineHeight="24"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="260">
                            <TextBlock x:Name="UltimatePrice" Text="---" FontSize="34" FontWeight="Bold"
                                       Margin="0,0,0,14" HorizontalAlignment="Center"/>
                            <Button x:Name="BuyUltimateButton"
                                    Margin="0,4,0,0"
                                    MinHeight="44"
                                    FontSize="15"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="BuyUltimate_Click"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource SystemAccentColorDark2}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="12,-10,28,0"
                        Padding="10,5"
                        CornerRadius="10">
                    <TextBlock x:Name="UltimateBadge"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="Bold"
                               TextAlignment="Center"/>
                </Border>
            </Grid>


            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,0,56" Padding="16" CornerRadius="20" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Top" HorizontalAlignment="Stretch" MinWidth="600" MaxWidth="1748" Height="980">
                <StackPanel>

                    <!-- Title -->
                    <TextBlock Text="{loc:Str Key=pro_compare_title}"
               FontSize="20"
               FontWeight="Bold"
               Margin="20,20,0,0"
               HorizontalAlignment="Left"
               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{loc:Str Key=pro_compare_subtitle}" FontWeight="Normal" FontSize="14" HorizontalAlignment="Left" Margin="20,10,0,10"/>

                    <!-- Header Row -->
                    <Grid Grid.ColumnSpan="3" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Str Key=label_features}" Grid.Column="0" FontWeight="SemiBold" Margin="20,0,0,0"/>
                        <TextBlock Text="{loc:Str Key=ai_free_user}" Grid.Column="1" TextAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Str Key=ai_pro_user}" Grid.Column="2" TextAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="PRO+" Grid.Column="3" TextAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Features List -->
                    <ItemsControl Grid.ColumnSpan="3" ItemsSource="{x:Bind FeatureList}" Margin="0,32,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:FeatureComparison">
                                <Grid Margin="0,5,0,5" Padding="0,0,0,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Title}" Grid.Column="0" FontWeight="SemiBold" Margin="20,0,0,0"/>
                                    <TextBlock Text="{x:Bind FreeCheckmark}" Grid.Column="1" TextAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ProCheckmark}" Grid.Column="2" TextAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ProPlusCheckmark}" Grid.Column="3" TextAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
