<Page
    x:Class="Atomic.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Atomic.App.Localization"
    xmlns:local="using:Atomic.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollMode="Auto">
        <Grid>
            <Grid HorizontalAlignment="Center" MaxWidth="1856" Width="Auto" Margin="0,24,0,0" Padding="56,0,36,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Appearance & Behavior Section -->
                <TextBlock Grid.Row="0"
                           Text="{loc:Str Key=settings_general}"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,16"/>

                <Grid Width="1800"/>

                <!--
                    Account. Lives here rather than in the nav pane because signing in is a
                    once-ever action, and a permanent pane entry would give it more prominence
                    than it earns.
                -->
                <Grid Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      Padding="12"
                      CornerRadius="8"
                      Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <!--
                            Headed user_title, matching the pane entry this opens. It read
                            "account", which has no German or Swedish translation.
                        -->
                        <TextBlock Text="{loc:Str Key=user_title}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Str Key=pro_additional_sync}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <!--
                        Was labelled enable_sync - "Aktivera Synkronisering". There is nothing to
                        activate: syncing starts at sign-in and continues on its own, so a button
                        offering to switch it on described the app inaccurately. A chevron says
                        "this opens somewhere" without needing a string, and the accessible name
                        comes from the heading in code-behind.
                    -->
                    <Button x:Name="OpenAccountButton"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="OpenAccount_Click">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                    </Button>
                </Grid>

                <!-- App Theme Setting -->
                <Grid Grid.Row="2"
                      HorizontalAlignment="Stretch"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      Padding="12"
                      CornerRadius="8"
                      Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Str Key=settings_theme_title}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Str Key=settings_theme_desc}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeComboBox"
                              Grid.Column="1"
                              HorizontalAlignment="Right"
                              SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="{loc:Str Key=settings_language_system}" Tag="Default" />
                        <ComboBoxItem Content="{loc:Str Key=light}" Tag="Light" />
                        <ComboBoxItem Content="{loc:Str Key=dark}" Tag="Dark" />
                    </ComboBox>
                </Grid>

                <!-- App Default Unit Setting -->
                <Grid Grid.Row="3"
                      HorizontalAlignment="Stretch"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      Padding="12"
                      CornerRadius="8"
                      Margin="0,-12,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Str Key=settings_temperature_title}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Str Key=settings_temperature_desc}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="UnitComboBox"
                              Grid.Column="1"
                              HorizontalAlignment="Right"
                              SelectionChanged="UnitComboBox_SelectionChanged">
                        <ComboBoxItem Content="Celsius" Tag="Celsius" />
                        <ComboBoxItem Content="Fahrenheit" Tag="Fahrenheit" />
                        <ComboBoxItem Content="Kelvin" Tag="Kelvin" />
                    </ComboBox>
                </Grid>

                <!-- App Language Setting -->
                <Grid Grid.Row="4"
                      HorizontalAlignment="Stretch"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      Padding="12"
                      CornerRadius="8"
                      Margin="0,-12,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="LanguageHeader" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="LanguageDescription"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="LanguageComboBox"
                              Grid.Column="1"
                              MinWidth="180"
                              HorizontalAlignment="Right"
                              SelectionChanged="LanguageComboBox_SelectionChanged" />
                </Grid>

                <!--
                    Usage analytics, Android's switch and Android's strings. On by default as there;
                    sends nothing at all in a build without firebase.analytics (Services/Analytics.cs).
                -->
                <Grid Grid.Row="5"
                      HorizontalAlignment="Stretch"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      Padding="12"
                      CornerRadius="8"
                      Margin="0,-12,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Str Key=analytics_title}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Str Key=analytics_desc}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AnalyticsToggle"
                                  Grid.Column="1"
                                  OnContent=""
                                  OffContent=""
                                  MinWidth="0"
                                  HorizontalAlignment="Right"
                                  Toggled="AnalyticsToggle_Toggled" />
                </Grid>

                <!-- About Section -->
                <TextBlock Grid.Row="6"
                           Text="{loc:Str Key=about_title}"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,8,0,16"/>

                <!-- Android App Card -->
                <Grid Grid.Row="7"
                      HorizontalAlignment="Stretch"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      Padding="12"
                      CornerRadius="8"
                      Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Str Key=settings_android_title}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Str Key=settings_android_desc}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <HyperlinkButton HorizontalAlignment="Right"
                                     FontSize="14"
                                     Content="{loc:Str Key=settings_android_link}"
                                     NavigateUri="https://play.google.com/store/apps/details?id=com.jlindemann.science" />
                </Grid>

                <!-- GitHub Card -->
                <Grid Grid.Row="8"
                      HorizontalAlignment="Stretch"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      Padding="12"
                      CornerRadius="8"
                      Margin="0,-12,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="GitHub" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Str Key=settings_github_desc}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <HyperlinkButton HorizontalAlignment="Right"
                                     FontSize="14"
                                     Content="GitHub Repo"
                                     NavigateUri="https://github.com/JLindemann42/Atomic-Periodic-Table.Windows" />
                </Grid>

                <!-- Version Info Card -->
                <Grid Grid.Row="9"
                      HorizontalAlignment="Stretch"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      Padding="12"
                      CornerRadius="8"
                      Margin="0,-12,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Str Key=about_app_name}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="J.LINDEMANN"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               FontSize="14"
                               Margin="0,0,10,0"
                               Text="v5.2.0d-Build.31"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
