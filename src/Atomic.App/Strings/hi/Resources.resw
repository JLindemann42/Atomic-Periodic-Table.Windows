  <data name="ai_concept_atomic_number" xml:space="preserve">
    <value>**परमाणु क्रमांक** एक परमाणु में प्रोटॉन की संख्या है। यह मुख्य तरीका है जिससे तत्वों को आवर्त सारणी में व्यवस्थित किया जाता है।</value>
  </data>
  <data name="ai_concept_electron" xml:space="preserve">
    <value>**इलेक्ट्रॉन** नकारात्मक रूप से चार्ज किए गए कण होते हैं जो नाभिक की परिक्रमा करते हैं। वे बॉन्डिंग और बिजली में शामिल होते हैं।</value>
  </data>
  <data name="ai_concept_electronegativity" xml:space="preserve">
    <value>**इलेक्ट्रोनगेटिविटी** मापती है कि एक परमाणु रासायनिक बंधन में इलेक्ट्रॉनों को अपनी ओर कितनी मजबूती से खींचता है। फ्लोरीन सबसे अधिक इलेक्ट्रोनगेटिव है!</value>
  </data>
  <data name="ai_concept_generic" xml:space="preserve">
    <value>यह रसायन विज्ञान में एक मुख्य अवधारणा है! आप इसके किस भाग के बारे में गहराई से जानना चाहेंगे? मैं प्रोटॉन, बॉन्डिंग, रेडियोधर्मिता और बहुत कुछ के बारे में जानता हूँ।</value>
  </data>
  <data name="ai_concept_group" xml:space="preserve">
    <value>एक **समूह** एक ऊर्ध्वाधर स्तंभ है। एक समूह के तत्वों में आमतौर पर समान रासायनिक गुण और संयोजी इलेक्ट्रॉनों की संख्या समान होती है।</value>
  </data>
  <data name="ai_concept_ionization" xml:space="preserve">
    <value>**आयनन ऊर्जा** एक परमाणु से एक इलेक्ट्रॉन को निकालने के लिए आवश्यक ऊर्जा है। यह आमतौर पर आवर्त सारणी में दाईं ओर बढ़ने पर बढ़ती है।</value>
  </data>
  <data name="ai_concept_isotope" xml:space="preserve">
    <value>एक **आइसोटोप** एक ही प्रोटॉन संख्या वाले तत्व का एक रूप है लेकिन न्यूट्रॉन की संख्या अलग होती है। यह इसके परमाणु द्रव्यमान को प्रभावित करता है!</value>
  </data>
  <data name="ai_concept_neutron" xml:space="preserve">
    <value>**न्यूट्रॉन** नाभिक में तटस्थ कण होते हैं। वे द्रव्यमान जोड़ते हैं और नाभिक को स्थिर करने में मदद करते हैं, विशेष रूप से भारी तत्वों में।</value>
