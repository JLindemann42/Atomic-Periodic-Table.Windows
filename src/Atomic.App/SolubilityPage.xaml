<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Atomic.App.SolubilityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!--
        The table is built in code from Atomic.Core's SolubilityData, the table Android shows too
        (roadmap 0.8, D58). It used to be ~700 lines of hand-placed cells that had drifted from
        Android and were wrong in places - sodium hydroxide insoluble, every sulfate soluble.
    -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="Table"
              Background="Transparent"
              Margin="56,24,56,24"
              HorizontalAlignment="Center"
              VerticalAlignment="Top" />
    </ScrollViewer>
</Page>
