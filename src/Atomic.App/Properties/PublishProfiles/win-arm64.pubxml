<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile for ARM64, selected by the project's <PublishProfile>win-$(Platform).pubxml</PublishProfile>.
  It is what gives a Release build its runtime identifier: without it, PublishReadyToRun has no
  runtime to compile for and the build fails with NETSDK1094.

  The Windows App SDK template's profile, with one deliberate difference: trimming stays off. The
  template turns it on for Release, and a publish profile overrides the project file - but a trimmed
  build renders the periodic table as 118 blank tiles. See Atomic.App.csproj and docs/porting-notes.md.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>ARM64</Platform>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <PublishDir>C:\Users\jonat\OneDrive\Skrivbord</PublishDir>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
  </PropertyGroup>
</Project>