<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile for x86, selected by the project's <PublishProfile>win-$(Platform).pubxml</PublishProfile>.
  It is what gives a Release build its runtime identifier: without it, PublishReadyToRun has no
  runtime to compile for and the build fails with NETSDK1094.

  The Windows App SDK template's profile, with one deliberate difference: trimming stays off. The
  template turns it on for Release, and a publish profile overrides the project file - but a trimmed
  build renders the periodic table as 118 blank tiles. See Atomic.App.csproj and docs/porting-notes.md.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x86</Platform>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>False</PublishSingleFile>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>
