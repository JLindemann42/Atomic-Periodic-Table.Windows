<Page
    x:Class="Atomic.App.Tools.IdealGasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Atomic.App.Tools"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid HorizontalAlignment="Center" MaxWidth="1856" Margin="0,24,0,24" Padding="56,0,36,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Calculator -->
            <Grid Grid.Column="0" VerticalAlignment="Top"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  Padding="16" CornerRadius="8" Margin="0,0,8,16">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="CardTitle" FontSize="14" FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SolveForLabel" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SolveForBox" Grid.Column="1" HorizontalAlignment="Stretch"
                                  SelectionChanged="SolveFor_SelectionChanged"/>
                    </Grid>

                    <!-- P, V, n, T. The one being solved for is disabled and dimmed. -->
                    <Grid x:Name="PressureRow" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PressureLabel" VerticalAlignment="Center"/>
                        <TextBox x:Name="PressureBox" Grid.Column="1" TextChanged="Input_TextChanged"/>
                        <ComboBox x:Name="PressureUnit" Grid.Column="2" HorizontalAlignment="Stretch"
                                  SelectionChanged="Unit_SelectionChanged"/>
                    </Grid>

                    <Grid x:Name="VolumeRow" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VolumeLabel" VerticalAlignment="Center"/>
                        <TextBox x:Name="VolumeBox" Grid.Column="1" TextChanged="Input_TextChanged"/>
                        <ComboBox x:Name="VolumeUnit" Grid.Column="2" HorizontalAlignment="Stretch"
                                  SelectionChanged="Unit_SelectionChanged"/>
                    </Grid>

                    <Grid x:Name="MolesRow" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MolesLabel" VerticalAlignment="Center"/>
                        <TextBox x:Name="MolesBox" Grid.Column="1" TextChanged="Input_TextChanged"/>
                        <TextBlock Grid.Column="2" Text="mol" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <Grid x:Name="TemperatureRow" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TemperatureLabel" VerticalAlignment="Center"/>
                        <TextBox x:Name="TemperatureBox" Grid.Column="1" TextChanged="Input_TextChanged"/>
                        <ComboBox x:Name="TemperatureUnit" Grid.Column="2" HorizontalAlignment="Stretch"
                                  SelectionChanged="Unit_SelectionChanged"/>
                    </Grid>

                    <Grid ColumnSpacing="8" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ResultLabel" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ResultText" Grid.Column="1" FontSize="18" VerticalAlignment="Center"
                                   IsTextSelectionEnabled="True"/>
                        <Button x:Name="SaveButton" Grid.Column="2" Click="SaveFavorite_Click"
                                ToolTipService.ToolTip="Save">
                            <FontIcon Glyph="&#xE734;" FontSize="14"/>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="NoteText" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Favourites -->
            <Grid Grid.Column="1" VerticalAlignment="Top"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  Padding="16" CornerRadius="8" Margin="8,0,0,16">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="FavoritesTitle" FontSize="14" FontWeight="SemiBold"/>

                    <StackPanel x:Name="ProGate" Spacing="12" Visibility="Collapsed"
                                HorizontalAlignment="Center" Margin="0,24,0,24">
                        <TextBlock x:Name="ProGateText" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Button x:Name="ProGateButton" Click="OpenProPage_Click"
                                HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}"/>
                    </StackPanel>

                    <ItemsControl x:Name="FavoritesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:SavedIdealGas">
                                <Grid Margin="0,0,0,8" Padding="10" CornerRadius="6"
                                      Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Summary}" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind Result}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="RemoveFavorite_Click" Tag="{x:Bind Summary}"
                                            Background="Transparent" BorderThickness="0"
                                            ToolTipService.ToolTip="Remove">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
